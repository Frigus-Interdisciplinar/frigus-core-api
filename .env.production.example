# Copie para .env.production (arquivo ignorado pelo Git) e preencha os valores reais.
DATABASE_URL=jdbc:postgresql://DB_HOST:5432/DB_NAME?sslmode=require
DATABASE_USERNAME=REPLACE_ME
DATABASE_PASSWORD=REPLACE_ME
REDIS_URL=rediss://default:REPLACE_ME@REDIS_HOST:6379
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# URLs/origens do frontend de PRODUÇÃO (configure o endereço real antes do deploy).
APP_FRONTEND_URL=https://REPLACE_WITH_PRODUCTION_FRONTEND_ORIGIN
CORS_ALLOWED_ORIGINS=https://REPLACE_WITH_PRODUCTION_FRONTEND_ORIGIN
SECURITY_ALLOWED_ORIGINS=https://REPLACE_WITH_PRODUCTION_FRONTEND_ORIGIN

# Integração de IA usada pelos fluxos de receitas.
FRIGUS_AI_BASE_URL=https://AI_API_HOST
FRIGUS_AI_API_KEY=REPLACE_ME
FRIGUS_AI_API_KEY_REQUIRED=true
# Mesmo valor de API_KEYS__CORE_SERVICE_KEY no serviço frigus-ai.
FRIGUS_AI_CORE_SERVICE_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS

# Segredo de assinatura para callbacks de cliques em anúncios.
AD_CLICK_REPORT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Configure se o fluxo de e-mail estiver habilitado em produção.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Frigus
GOOGLE_CLIENT_ID=

# Só configure uma CIDR de proxy se ela for conhecida e controlada.
SECURITY_TRUSTED_PROXY_CIDRS=
