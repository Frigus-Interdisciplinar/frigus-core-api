DATABASE_URL=your_database_url
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password

REDIS_URL=your_redis_url

JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRATION=900000

FRIGUS_AI_BASE_URL=frigus_ai_prod_url_here

AWS_REGION=us-east-1
AWS_S3_ENABLED=false
AWS_S3_BUCKET=

FRIGUS_AI_API_KEY=frigus_ai_api_key_here
# Local Compose overrides database/Redis URLs; it does not use remote credentials.
LOCAL_API_PORT=8080
LOCAL_POSTGRES_PORT=55432
LOCAL_REDIS_PORT=56379
LOCAL_MAIL_PORT=8025
LOCAL_POSTGRES_PASSWORD=frigus-local-only
LOCAL_FRONTEND_URL=http://localhost:5173
LOCAL_AI_BASE_URL=http://host.docker.internal:8000
APP_TIME_ZONE=America/Sao_Paulo
APP_FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@frigus.local
SMTP_AUTH=false
SMTP_STARTTLS=false
# Existing databases only, after checking legacy migrations 001-003:
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=3
