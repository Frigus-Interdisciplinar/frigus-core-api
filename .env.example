DATABASE_URL=your_database_url
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_database_password

REDIS_URL=your_redis_url

JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRATION=900000

# Origem do frigus-ai, sem /v1: o Core usa /internal/core/chat.
FRIGUS_AI_BASE_URL=http://localhost:8000

AWS_REGION=us-east-1
AWS_S3_ENABLED=false
AWS_S3_BUCKET=

FRIGUS_AI_API_KEY=frigus_ai_api_key_here
# Deve corresponder a API_KEYS__CORE_SERVICE_KEY no serviço frigus-ai.

# local Compose overrides database/Redis URLs; it does not use remote credentials.
LOCAL_API_PORT=8080
LOCAL_POSTGRES_PORT=55432
LOCAL_REDIS_PORT=56379
LOCAL_POSTGRES_PASSWORD=frigus-local-only
LOCAL_FRONTEND_URL=http://localhost:5173
LOCAL_AI_BASE_URL=http://host.docker.internal:8000
APP_TIME_ZONE=America/Sao_Paulo
APP_FRONTEND_URL=http://localhost:5173

# sender needs to be validated in your brevo account
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=adicione_sua_chave_da_api_brevo
BREVO_SMTP_KEY=adicione_sua_chave_smtp_da_brevo
BREVO_SENDER_EMAIL=remetente_verificado_na_brevo@example.com
BREVO_SENDER_NAME=Frigus

FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=3

AD_CLICK_REPORT_SECRET=shared_hmac_secret_for_trusted_click_provider
GOOGLE_CLIENT_ID=google_id_here
