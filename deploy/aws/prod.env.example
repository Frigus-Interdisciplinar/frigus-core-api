# Copie para prod.env (ignorado pelo Git) e substitua todos os exemplos.
AWS_PROFILE=frigus-prod
AWS_REGION=us-east-1
EKS_CLUSTER_NAME=frigus-prod

# Host público do BFF, sem protocolo.
API_HOST=api.example.com
ALB_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/REPLACE_ME

# Origens exatas do frontend, separadas por vírgula.
FRONTEND_ORIGINS=https://app.example.com
APP_FRONTEND_URL=https://app.example.com

# CIDRs das subnets onde o ALB será criado. Substitua pelos CIDRs reais do VPC.
SECURITY_TRUSTED_PROXY_CIDRS=10.0.1.0/24,10.0.2.0/24
