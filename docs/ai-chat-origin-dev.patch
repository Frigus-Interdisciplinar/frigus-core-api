+    /** Accept an origin or the previous /v1 configuration, never concatenate arbitrary route prefixes. */
+    static String normalizeBaseUrl(String value) {
+        final URI uri;
+        try { uri = URI.create(value == null ? "" : value.trim()); }
+        catch (IllegalArgumentException exception) {
+            throw new IllegalStateException("FRIGUS_AI_BASE_URL must be an HTTP(S) origin or end in /v1");
+        }
+        String path = uri.getRawPath();
+        if (!(uri.getScheme() != null && (uri.getScheme().equalsIgnoreCase("http") || uri.getScheme().equalsIgnoreCase("https"))) ||
+                uri.getHost() == null || uri.getRawUserInfo() != null || uri.getRawQuery() != null || uri.getRawFragment() != null ||
+                !(path == null || path.isEmpty() || path.equals("/") || path.equals("/v1") || path.equals("/v1/")))
+            throw new IllegalStateException("FRIGUS_AI_BASE_URL must be an HTTP(S) origin or end in /v1");
+        return uri.getScheme() + "://" + uri.getRawAuthority();
+    }
